{
    "name": "adereksisusanto/laravel-generator",
    "description": "Generate Laravel models, migrations, and seeders from existing database tables",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "generator",
        "laravel",
        "model",
        "migration",
        "seeder",
        "scaffold",
        "code-generator",
        "eloquent",
        "database",
        "php"
    ],
    "authors": [
        {
            "name": "Adereksisusanto",
            "email": "adereksisusanto@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0",
        "illuminate/console": "^9.0",
        "illuminate/filesystem": "^9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.4",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Adereksisusanto\\Laravel\\Generator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adereksisusanto\\Laravel\\Generator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "format": "pint",
        "lint": "pint --test",
        "lint-fix": "pint",
        "analyse": "phpstan analyse",
        "analyse:baseline": "phpstan analyse --generate-baseline",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Adereksisusanto\\Laravel\\Generator\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
